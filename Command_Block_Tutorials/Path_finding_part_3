# Path finding mit Command Blocks
# Code example for my Youtube tutorial videos
# Video: https://youtu.be/5QBNvoKX1cM

# Init
kill @e[type=villager, tag=tutorial_patrolie3]
summon villager 1263 4 1694 {NoAI:1b,Rotation:[0,0], Tags:["tutorial_patrolie3"]}

# run
execute as @e[tag=tutorial_patrolie3] at @s if block ~ ~-1 ~ minecraft:magenta_glazed_terracotta[facing=south] align x run teleport @s ~.5 ~ ~-0.05 180 0
execute as @e[tag=tutorial_patrolie3] at @s if block ~ ~-1 ~ minecraft:magenta_glazed_terracotta[facing=west] align z run teleport @s ~0.05 ~ ~.5 -90 0
execute as @e[tag=tutorial_patrolie3] at @s if block ~ ~-1 ~ minecraft:magenta_glazed_terracotta[facing=north] align x run teleport @s ~.5 ~ ~0.05 0 40
execute as @e[tag=tutorial_patrolie3] at @s if block ~ ~-1 ~ minecraft:magenta_glazed_terracotta[facing=east] align z run teleport @s ~-0.05 ~ ~.5 90 0
