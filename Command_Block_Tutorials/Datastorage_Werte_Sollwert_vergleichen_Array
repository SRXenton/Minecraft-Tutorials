## fill_small.mcfcuntion
$execute unless data storage tutorial:datastorage_vergleich_part2 data.array[{coords:[$(x),$(y),$(z)],text:"$(t1)"}] \
    run data modify storage tutorial:datastorage_vergleich_part2 data.array append value {coords:[$(x),$(y),$(z)],text:"$(t1)"}


function datastorage_vergleich_part2:output


## fill.mcfcuntion
