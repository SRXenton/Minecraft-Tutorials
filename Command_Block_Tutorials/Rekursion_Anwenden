## setze_block.mcfunction

function schleifen:nutzen_rekursion/reset

scoreboard objectives add tutorials.schleifen.rekursion.nutzen dummy
scoreboard players set _i tutorials.schleifen.rekursion.nutzen 0

$data modify storage tutorial:nutzen_rekursion data.block set value {x:$(x),y:$(y),z:$(z)}
$data modify storage tutorial:nutzen_rekursion data.search set value $(id)

execute store result score _i_max tutorials.schleifen.rekursion.nutzen if data storage tutorial:nutzen_rekursion data.dataSet[]

execute store result storage tutorial:nutzen_rekursion data.i int 1 run scoreboard players get _i tutorials.schleifen.rekursion.nutzen


