## Neue Datapack Struktur:

# Datapack Strucktur:
# (+) = Neu
# (>) = Bearbeiten
# (-) = Entfernen
# (*) = Alt/Vorhanden
* Main
    * data
        * character
            * function
                * misc
                    + reset_base_values.mcfcuntion
                    + character_new_values.mcfcuntion
        * combat
            * function
                + kill
                    + kill_calculate.mcfcuntion
                    + kill_detect.mcfcuntion
                    + kill_get_data.mcfcuntion
                    + kill_init.mcfcuntion
                * tick
                    > tick_switch.mcfunction



### Files: (Kommenrtare entfernt)
## reset_base_values.mcfcuntion
$data merge storage main_charakter:player {data:{"$(UUID)":{beweglichkeit:1,staerke:1,ausdauer:1,intelligenz:1}}}

## character_new_values.mcfcuntion
$data modify storage main_charakter:player data."$(UUID)" set from storage $(storage)

## kill_calculate.mcfcuntion
data modify storage main:kill data.temp.storage set value "main:kill data.temp.values"

scoreboard objectives add main.kill_temp dummy

execute store result score _temp main.kill_temp run data get storage main:kill data.temp.values.staerke 1000
#scoreboard < (data * 1000)

scoreboard players add _temp main.kill_temp 1
#scoreboard > (data / 1000)

execute store result storage main:kill data.temp.values.staerke double 0.001 run scoreboard players get _temp main.kill_temp

function character:misc/character_new_values with storage main:kill data.temp

scoreboard objectives remove main.kill_temp


## kill_detect.mcfcuntion
data merge storage main:kill {data:{temp:{}}}

execute as @a[scores={main.kill_detect=1.., main.kill_detect_player=0}] run function combat:kill/kill_get_data with entity @s
execute as @a[scores={main.kill_detect=1.., main.kill_detect_player=0}] run function combat:kill/kill_calculation with entity @s

scoreboard players set @a main.kill_detect_player 0
scoreboard players set @a main.kill_detect 0

data remove storage main:kill data.temp


## kill_get_data.mcfcuntion
$data modify storage main:kill data.temp.values set from storage main_charakter:player data."$(UUID)"
$data modify storage main:kill data.temp.UUID set value "$(UUID)"


## kill_init.mcfcuntion
scoreboard objectives add main.kill_detect totalKillCount
scoreboard objectives add main.kill_detect_player playerKillCount

scoreboard objectives setdisplay sidebar main.kill_detect
#scoreboard objectives setdisplay sidebar main.kill_detect_player


## tick_switch.mcfcuntion
function combat:tick/set_base

function combat:tick/remove_xp_orbs

function combat:kill/kill_detect