##
## Beschreibung zu Folge 047: 
##

- Titel: MC Datapack Tutorial [1.21.11+]#047 - Waffe bleibt Waffe nach Attributänderung (loot table, item modify)

- Video: https://youtu.be/JyAW0Rdv2_A

## Ziele der Folge:

- Unterschied erklären: Item modify entity zu item_modifier.json
- Aufbau Loot_table und item_modifier
- Erstellen eines Custom Wooden Sword als Stone Sword mit custom Werten


##
## ============================================================================================================================================
##

## Links:

Minecraft Wiki:
- https://de.minecraft.wiki/


## Neue Datapack Struktur:

# Datapack Strucktur:
# (+) = Neu
# (>) = Bearbeiten
# (-) = Entfernen
# (*) = Alt/Vorhanden
* Main
    * data
        * combat
            + item_modifier
				+ attack_damage_reduce_wooden_sword_to_base.json
				+ attack_speed_reduce_wooden_sword_to_base.json
				+ attack_damage_add_0.5.json
            * loot_table
				+ starter_sword.json



### Files: (Kommenrtare entfernt)
## attack_damage_reduce_wooden_sword_to_base.json 
{
    "function": "set_attributes",
    "modifiers": [
        {
            "id": "attack_damage_reduce_wooden_sword_to_base",
            "amount": -3.0,
            "attribute": "attack_damage",
            "operation": "add_value",
            "slot": "mainhand"
        }
    ],
    "replace": false
}

## attack_speed_reduce_wooden_sword_to_base.json 
{
    "function": "set_attributes",
    "modifiers": [
        {
            "id": "attack_damage_reduce_wooden_swood_to_base",
            "amount":2.4,
            "attribute": "minecraft:attack_speed",
            "operation": "add_value",
            "slot": "mainhand"
        }
    ],
    "replace": false
}

## attack_damage_add_0.json 
{
    "function": "set_attributes",
    "modifiers": [
        {
            "id": "attack_damage_add_0.5",
            "amount": 0.5,
            "attribute": "attack_damage",
            "operation": "add_value",
            "slot": "mainhand"
        }
    ],
    "replace": false
}

## starter_sword.json 
{
  "pools": [
    {
      "rolls": 1,
      "entries": [
        {
          "type": "minecraft:item",
          "name": "minecraft:wooden_sword",
          "functions": [
            {
              "function": "set_components",
              "components": {
                "item_model": "minecraft:stone_sword"
              }
            },
            {
              "function": "minecraft:set_lore",
              "lore": [
                {
                  "text": "Ein gewöhnliches einfaches Schwert.",
                  "color": "#ffffff"
                },
                {
                  "text": "",
                  "color": "#ffffff"
                },
                {
                  "text": "Werte:",
                  "color": "#838365"
                },
                {
                  "text": "+0.5 Attack Damage.",
                  "color": "#f6ff00"
                }
              ],
              "mode": "replace_all"
            },
            {
              "function": "minecraft:set_name",
              "name": {
                "text": "Einfaches Schwert",
                "color": "#ffffff"
              }
            },
            {
              "function": "toggle_tooltips",
              "toggles": {
                "attribute_modifiers": false
              }
            },
            {
              "function": "minecraft:reference",
              "name": "combat:attack_damage_reduce_wooden_swood_to_base"
            },
            {
              "function": "minecraft:reference",
              "name": "combat:attack_speed_reduce_wooden_sword_to_base"
            },
            {
              "function": "minecraft:reference",
              "name": "combat:attack_damage_add_0.5"
            }
          ]
        }
      ]
    }
  ],
  "functions": []
}
