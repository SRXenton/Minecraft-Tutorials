## Neue Datapack Struktur:

# Datapack Strucktur:
# (+) = Neu
# (>) = Bearbeiten
# (-) = Entfernen
# (*) = Alt/Vorhanden
* Main
    * data
        * quests_dorf1
            * function
				* waechter
	                + summon_route_loaded.mcfunction
					* patrolie
		                + check_entity_waechter.mcfunction
		                + detect_player.mcfunction
		                + switch.mcfunction



### Files: (Kommenrtare entfernt)
## summon_route_loaded.mcfunction 
execute unless entity @e[distance=..3,tag=panda_village_route_check] run kill @e[tag=panda_village_route_check]

execute unless entity @e[distance=..3,tag=panda_village_route_check] run summon text_display ~ ~1 ~ {text:"Route geladen check", Tags:["panda_village","panda_village_route_check"]}


## check_entity_waechter.mcfunction 
execute store result score _check Panda_Village_wachter if entity @e[tag=panda_village_route_check]

execute if score _check Panda_Village_wachter matches 4 unless entity @e[tag=panda_village_waechter] run function quests_dorf1:waechter/summon_waechter


## detect_player.mcfunction 
execute as @e[tag=panda_village_waechter] at @s positioned ^ ^ ^2 store result score _check_if_player_before_entity Panda_Village_wachter if entity @a[distance=..3]


## switch.mcfunction 
scoreboard objectives add Panda_Village_wachter dummy

execute if score _counter_0_to_20 Global_Variables matches 15 run function quests_dorf1:waechter/patrolie/check_entity_waechter

execute unless score _check_if_player_before_entity Panda_Village_wachter matches 1 run function quests_dorf1:waechter/patrolie/patrolie

function quests_dorf1:waechter/patrolie/detect_player

scoreboard objectives setdisplay sidebar Panda_Village_wachter

